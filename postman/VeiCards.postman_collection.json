{
  "info": {
    "name": "VEI Cards API",
    "description": "Coleção completa da API REST da VEI Cards. Rode 'Login (admin)' primeiro — o token é salvo automaticamente nas variáveis de ambiente e reutilizado por todas as outras requisições.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Registrar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/autenticacao/registrar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "autenticacao",
                "registrar"
              ]
            },
            "description": "Cria uma conta (username aleatório a cada execução) e já autentica.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomeUsuario\": \"user_{{$randomUUID}}\",\n  \"email\": \"{{$randomUUID}}@teste.com\",\n  \"nomeExibicao\": \"Novo Usuário\",\n  \"senha\": \"senha123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const corpo = pm.response.json();",
                  "if (corpo.token) pm.environment.set(\"token\", corpo.token);",
                  "if (corpo.refreshToken) pm.environment.set(\"refreshToken\", corpo.refreshToken);",
                  "if (corpo.expiracao) pm.environment.set(\"dataExpiracao\", corpo.expiracao);",
                  "if (corpo.usuario && corpo.usuario.id) pm.environment.set(\"usuarioId\", corpo.usuario.id);",
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/autenticacao/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "autenticacao",
                "login"
              ]
            },
            "description": "Login com o admin criado pelo seed inicial. Rode esta requisição antes das demais para autenticar como admin.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomeUsuario\": \"{{usuarioAdmin}}\",\n  \"senha\": \"{{senhaAdmin}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const corpo = pm.response.json();",
                  "if (corpo.token) pm.environment.set(\"token\", corpo.token);",
                  "if (corpo.refreshToken) pm.environment.set(\"refreshToken\", corpo.refreshToken);",
                  "if (corpo.expiracao) pm.environment.set(\"dataExpiracao\", corpo.expiracao);",
                  "if (corpo.usuario && corpo.usuario.id) pm.environment.set(\"usuarioId\", corpo.usuario.id);",
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Renovar sessão (refresh)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/autenticacao/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "autenticacao",
                "refresh"
              ]
            },
            "description": "Troca o refresh token atual por um par novo (rotação — o antigo é revogado).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const corpo = pm.response.json();",
                  "if (corpo.token) pm.environment.set(\"token\", corpo.token);",
                  "if (corpo.refreshToken) pm.environment.set(\"refreshToken\", corpo.refreshToken);",
                  "if (corpo.expiracao) pm.environment.set(\"dataExpiracao\", corpo.expiracao);",
                  "if (corpo.usuario && corpo.usuario.id) pm.environment.set(\"usuarioId\", corpo.usuario.id);",
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
